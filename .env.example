# ==============================================================================
# KIDROO BACKEND ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173,https://kidroo.in
FRONTEND_URL=http://localhost:5173

# Database & Cache Configuration
DB_URL=mongodb://127.0.0.1:27017/kidroo
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Shipping & Logistics (Shiprocket API)
SHIPROCKET_EMAIL=your_shiprocket_api_email
SHIPROCKET_PASSWORD=your_shiprocket_api_password
SHIPROCKET_PICKUP_PINCODE=395006

# Official Meta WhatsApp Cloud API Integration
META_WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_system_user_access_token
META_WHATSAPP_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_whatsapp_waba_id
META_WHATSAPP_API_VERSION=v20.0

# Messaging & Communication (MSG91 SMS & OTP)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=KIDROO
MSG91_ROUTE=4
MSG91_COUNTRY=91
MSG91_ENTITY_ID=your_dlt_entity_id
MSG91_TEMPLATE_ID=your_dlt_template_id
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id
MSG91_RESET_PASSWORD_TEMPLATE_ID=your_msg91_reset_password_template_id
MSG91_OTP_VIA_SMS=false

# MSG91 Transactional Email
MSG91_EMAIL_DOMAIN=yourdomain.com
MSG91_EMAIL_FROM_NAME="Kidroo Toys"
MSG91_EMAIL_FROM_ADDRESS=noreply@yourdomain.com
MSG91_EMAIL_OTP_TEMPLATE_ID=your_email_otp_template_id
MSG91_EMAIL_ORDER_CONFIRMED_TEMPLATE_ID=your_email_order_confirmed_template_id
MSG91_EMAIL_RESET_PASSWORD_TEMPLATE_ID=your_email_reset_password_template_id

# SMTP Mailer (Brevo Fallback)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_user
BREVO_SMTP_PASS=your_brevo_password

# Alternative SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
